# Language of the feeds: ar (default, tuned) or any ISO code (en, de, fr, ...)
NEWSAI_LANG=ar

# LLM provider (OpenAI-compatible API; DeepSeek by default)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_A=deepseek-chat
MODEL_B=deepseek-chat

# HTTP control server (send the key as X-API-Key)
NEWSAI_API_KEY=
PORT=8080
NEWSAI_INTERVAL_SECONDS=3600
NEWSAI_RUN_ON_START=1

# State: SQLite file by default; MySQL 8.0.19+ also supported
# DATABASE_URL=mysql://newsai:password@127.0.0.1:3306/newsai
